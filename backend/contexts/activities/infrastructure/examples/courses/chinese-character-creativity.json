{
  "course_key": "chinese-character-creativity",
  "title": "Chinese character creativity training",
  "source": "NSTC undergraduate research project: AI-empowered cooperative learning platform for creativity via Chinese character properties",
  "activity_types": [
    {
      "key": "crat-word-puzzle",
      "name": "字詞拼圖（中文遠距聯想測驗）",
      "validator_kind": "in_process",
      "validator_config": {
        "validator_id": "filled_count_coverage",
        "min_filled": 2
      },
      "retention_days": null,
      "expose_payload_to_agent": true,
      "echo_includes_content": false,
      "group_config": {
        "consent": {
          "numerator": 2,
          "denominator": 3
        }
      },
      "payload_schema": {
        "type": "object",
        "properties": {
          "target_character": {
            "type": "string",
            "title": "目標字",
            "description": "能與三個線索字分別組成合法詞彙的那個字。",
            "x-order": 1
          },
          "word_1": {
            "type": "string",
            "title": "詞彙一",
            "description": "目標字與第一個線索字組成的詞彙。",
            "x-order": 2
          },
          "word_2": {
            "type": "string",
            "title": "詞彙二",
            "description": "目標字與第二個線索字組成的詞彙。",
            "x-order": 3
          },
          "word_3": {
            "type": "string",
            "title": "詞彙三",
            "description": "目標字與第三個線索字組成的詞彙。",
            "x-order": 4
          },
          "reasoning": {
            "type": "string",
            "title": "推理歷程",
            "description": "小組是怎麼找到這個字的？經歷了哪些聯想和討論？",
            "x-order": 5
          }
        },
        "required": [
          "target_character"
        ]
      }
    },
    {
      "key": "character-building",
      "name": "拆字蓋樓（部件擴散思考任務）",
      "validator_kind": "in_process",
      "validator_config": {
        "validator_id": "filled_count_coverage",
        "min_filled": 2
      },
