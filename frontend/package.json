{
  "name": "@smap/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "fmt": "prettier --write .",
    "typecheck": "vue-tsc --build --noEmit",
    "test": "vitest run",
    "gen:api": "openapi --input ../backend/openapi.json --output src/shared/api-client --client axios --useOptions --useUnionTypes",
    "check:openapi-drift": "bash scripts/check-openapi-drift.sh",
    "check:boundaries-enforced": "bash scripts/check-boundaries-enforced.sh",
    "check:bundle-size": "bash scripts/check-bundle-size.sh",
    "check:global-css": "bash scripts/check-global-css.sh",
    "check:view-tests": "bash scripts/check-view-tests.sh",
    "check:type-coverage": "bash scripts/check-type-coverage.sh",
    "check:typecheck-gate": "bash scripts/check-typecheck-gate.sh",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@heroicons/vue": "^2.2.0",
    "@tanstack/vue-query": "5.101.4",
    "@vee-validate/zod": "4.15.1",
    "@vue/devtools-api": "8.1.5",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "1.48.2",
    "axios": "1.19.0",
    "dompurify": "3.4.12",
    "highlight.js": "11.11.1",
    "katex": "0.18.1",
    "markdown-it": "14.3.0",
    "mermaid": "11.16.1",
    "pinia": "4.0.2",
    "vee-validate": "4.15.1",
    "vue": "3.5.40",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "3.2.0",
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "9.28.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "7.1.0",
    "eslint-plugin-vue": "10.10.0",
    "eslint-plugin-vuejs-accessibility": "2.5.0",
    "form-data": "4.0.6",
    "jsdom": "26.1.0",
    "msw": "2.7.3",
    "openapi-typescript-codegen": "0.31.0",
    "tailwindcss": "^4.3.3",
    "type-coverage": "2.30.1",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue-tsc": "2.1.10"
  }
}
