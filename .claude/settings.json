{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-File",
              ".claude\\hooks\\mirror-skills.ps1"
            ],
            "timeout": 30,
            "statusMessage": "Mirroring skills to .agents"
          }
        ]
      }
    ]
  }
}
